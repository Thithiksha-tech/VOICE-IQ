# VoiceIQ Backend Environment Configuration

# Server Host and Port
HOST=0.0.0.0
PORT=8000

# Security & JWT
SECRET_KEY=voiceiq_mca_project_super_secret_jwt_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite local file, can easily switch to postgresql://user:pass@host/dbname)
DATABASE_URL=sqlite:///./voiceiq.db

# AI Service Credentials
# Option 1: Gemini API (Preferred for full speech + communication analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: OpenAI API (Optional alternative for Whisper / GPT-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Upload directory for student voice recordings
UPLOAD_DIR=./data/uploads
